{
  "name": "dusty-jukebox-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prebuild": "npm test && node scripts/test-e2e-if-chromium.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/copy-dist-app.mjs && echo 'Deploy complete. Commit and push to deploy.'"
  },
  "dependencies": {
    "encoding-japanese": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
